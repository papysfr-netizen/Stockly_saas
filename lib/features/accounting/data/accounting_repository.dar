import 'package:cloud_firestore/cloud_firestore.dart';
import '../../../models/comptabilite_models.dart';
import '../extensions/journal_entry_firestore_x.dart';

class AccountingRepository {
  final FirebaseFirestore _firestore;

  AccountingRepository({FirebaseFirestore? firestore})
      : _firestore = firestore ?? FirebaseFirestore.instance;

  CollectionReference<Map<String, dynamic>> _journalsRef(String entrepriseId) {
    return _firestore
        .collection('organizations')
        .doc(entrepriseId)
        .collection('journals');
  }

  /// Sauvegarde une écriture comptable après vérification de la partie double
  Future<void> saveEcriture(EcritureComptable ecriture) async {
    if (!ecriture.estEquilibree) {
      throw Exception('L\'écriture comptable n\'est pas équilibrée (Total Débit != Total Crédit).');
    }

    await _journalsRef(ecriture.entrepriseId)
        .doc(ecriture.id)
        .set(ecriture.toFirestore());
  }

  /// Sauvegarde un lot d'écritures en une transaction (ex: Vente + Déstockage)
  Future<void> saveEcrituresBatch({
    required String entrepriseId,
    required List<EcritureComptable> ecritures,
  }) async {
    final batch = _firestore.batch();
    for (final ecriture in ecritures) {
      if (!ecriture.estEquilibree) {
        throw Exception('Une des écritures (${ecriture.pieceRef}) n\'est pas équilibrée.');
      }
      final docRef = _journalsRef(entrepriseId).doc(ecriture.id);
      batch.set(docRef, ecriture.toFirestore());
    }
    await batch.commit();
  }

  /// Flux en temps réel des écritures comptables d'une entreprise
  Stream<List<EcritureComptable>> watchEcritures(String entrepriseId) {
    return _journalsRef(entrepriseId)
        .orderBy('date', descending: true)
        .snapshots()
        .map((snapshot) => snapshot.docs
            .map((doc) => EcritureComptableFirestoreX.fromFirestore(doc))
            .toList());
  }
}