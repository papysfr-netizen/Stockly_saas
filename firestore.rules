rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utiles ----------

    function estConnecte() {
      return request.auth != null;
    }

    function profilExiste() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function monProfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function monEntreprise() {
      return monProfil().entrepriseId;
    }

    function estMembre(entId) {
      return estConnecte() && profilExiste() && monEntreprise() == entId;
    }

    // L'utilisateur est le propriétaire (ownerId) de cette entreprise
    function estProprietaireDe(entId) {
      return estConnecte()
        && get(/databases/$(database)/documents/entreprises/$(entId)).data.ownerId == request.auth.uid;
    }

    // L'entreprise est en train d'être créée par cet utilisateur (inscription)
    function creeParMoi(entId) {
      return estConnecte()
        && getAfter(/databases/$(database)/documents/entreprises/$(entId)).data.ownerId == request.auth.uid;
    }

    // ---------- Profils utilisateurs ----------
    match /users/{userId} {

      // Lire : son propre profil, ou les membres de SA boutique s'il en est le propriétaire
      allow read: if estConnecte() && (
        request.auth.uid == userId
        || estProprietaireDe(resource.data.entrepriseId)
      );

      // Créer :
      //  - son propre profil lors de l'inscription de sa boutique ;
      //  - OU (propriétaire) le profil d'un Gérant / Caissier de SA boutique.
      allow create: if estConnecte() && (
        (request.auth.uid == userId && creeParMoi(request.resource.data.entrepriseId))
        || (
          estProprietaireDe(request.resource.data.entrepriseId)
          && request.resource.data.role in ['gerant', 'caissier']
        )
      );

      // Modifier :
      //  - son propre profil, sans toucher au rôle ni à l'entreprise ;
      //  - OU (propriétaire) un membre de SA boutique : jamais en Propriétaire,
      //    jamais vers une autre boutique, jamais le compte du propriétaire.
      allow update: if estConnecte() && (
        (
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'entrepriseId', 'uid'])
        )
        || (
          estProprietaireDe(resource.data.entrepriseId)
          && resource.data.role != 'owner'
          && request.resource.data.entrepriseId == resource.data.entrepriseId
          && request.resource.data.role in ['gerant', 'caissier']
        )
      );

      // Supprimer : jamais (on désactive un employé à la place)
      allow delete: if false;
    }

    // ---------- Entreprises ----------
    match /entreprises/{entId} {
      allow read: if estMembre(entId);
      allow create: if estConnecte() && request.resource.data.ownerId == request.auth.uid;
      allow update: if estMembre(entId) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /{sousDocument=**} {
        allow read: if estMembre(entId);
        allow write: if estMembre(entId) || creeParMoi(entId);
      }
    }

    // ---------- Dépenses (collection principale) ----------
    match /depenses/{depenseId} {
      allow read: if estConnecte() && resource.data.entrepriseId == monEntreprise();
      allow create: if estConnecte() && request.resource.data.entrepriseId == monEntreprise();
      allow update: if estConnecte() && resource.data.entrepriseId == monEntreprise()
        && request.resource.data.entrepriseId == resource.data.entrepriseId;
      allow delete: if estConnecte() && resource.data.entrepriseId == monEntreprise();
    }

    // ---------- Ancien chemin (écran Équipe de démonstration) ----------
    match /organizations/{entId}/{document=**} {
      allow read, write: if estMembre(entId);
    }
  }
}