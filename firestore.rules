rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utiles ----------

    // L'utilisateur est connecté
    function estConnecte() {
      return request.auth != null;
    }

    // Le profil users/{uid} de l'utilisateur existe
    function profilExiste() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // L'entreprise à laquelle l'utilisateur appartient
    function monEntreprise() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.entrepriseId;
    }

    // L'utilisateur est membre de cette entreprise
    function estMembre(entId) {
      return estConnecte() && profilExiste() && monEntreprise() == entId;
    }

    // L'entreprise est en train d'être créée par cet utilisateur (inscription)
    function creeParMoi(entId) {
      return estConnecte()
        && getAfter(/databases/$(database)/documents/entreprises/$(entId)).data.ownerId == request.auth.uid;
    }

    // ---------- Profils utilisateurs ----------
    match /users/{userId} {
      // Chacun ne lit que son propre profil
      allow read: if estConnecte() && request.auth.uid == userId;
      // Création seulement lors de l'inscription de sa propre entreprise
      allow create: if estConnecte() && request.auth.uid == userId
        && creeParMoi(request.resource.data.entrepriseId);
      // Personne ne peut changer lui-même son rôle ou son entreprise
      allow update: if estConnecte() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'entrepriseId', 'uid']);
      allow delete: if false;
    }

    // ---------- Entreprises ----------
    match /entreprises/{entId} {
      allow read: if estMembre(entId);
      allow create: if estConnecte() && request.resource.data.ownerId == request.auth.uid;
      // On ne peut pas changer le propriétaire
      allow update: if estMembre(entId) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      // Produits, ventes, créances, écritures, boutiques...
      match /{sousDocument=**} {
        allow read: if estMembre(entId);
        allow write: if estMembre(entId) || creeParMoi(entId);
      }
    }

    // ---------- Dépenses (collection principale) ----------
    match /depenses/{depenseId} {
      allow read: if estConnecte() && resource.data.entrepriseId == monEntreprise();
      allow create: if estConnecte() && request.resource.data.entrepriseId == monEntreprise();
      allow update: if estConnecte() && resource.data.entrepriseId == monEntreprise()
        && request.resource.data.entrepriseId == resource.data.entrepriseId;
      allow delete: if estConnecte() && resource.data.entrepriseId == monEntreprise();
    }

    // ---------- Ancien chemin (écran Équipe) ----------
    match /organizations/{entId}/{document=**} {
      allow read, write: if estMembre(entId);
    }

    // Tout le reste est refusé par défaut
  }
}