rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utiles ----------

    function estConnecte() {
      return request.auth != null;
    }

    function profilExiste() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function monProfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function monEntreprise() {
      return monProfil().entrepriseId;
    }

    function monRole() {
      return monProfil().get('role', 'caissier');
    }

    // Compte actif (un compte sans le champ estActif est considéré actif)
    function estActif() {
      return monProfil().get('estActif', true) != false;
    }

    function estMembre(entId) {
      return estConnecte() && profilExiste() && monEntreprise() == entId && estActif();
    }

    // L'utilisateur est le propriétaire (ownerId) de cette entreprise
    function estProprietaireDe(entId) {
      return estConnecte()
        && get(/databases/$(database)/documents/entreprises/$(entId)).data.ownerId == request.auth.uid;
    }

    // Propriétaire ou Gérant de cette entreprise (anciens noms de rôles acceptés)
    function estGerantOuPlus(entId) {
      return estMembre(entId) && (
        estProprietaireDe(entId)
        || monRole() in ['owner', 'proprietaire', 'patron', 'gerant', 'admin',
                         'administrateur', 'chefboutique', 'chef_boutique', 'chef', 'comptable']
      );
    }

    // L'entreprise est en train d'être créée par cet utilisateur (inscription)
    function creeParMoi(entId) {
      return estConnecte()
        && getAfter(/databases/$(database)/documents/entreprises/$(entId)).data.ownerId == request.auth.uid;
    }

    // ---------- Profils utilisateurs ----------
    match /users/{userId} {

      allow read: if estConnecte() && (
        request.auth.uid == userId
        || estProprietaireDe(resource.data.entrepriseId)
      );

      allow create: if estConnecte() && (
        (request.auth.uid == userId && creeParMoi(request.resource.data.entrepriseId))
        || (
          estProprietaireDe(request.resource.data.entrepriseId)
          && request.resource.data.role in ['gerant', 'caissier']
        )
      );

      allow update: if estConnecte() && (
        (
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'entrepriseId', 'uid', 'estActif'])
        )
        || (
          estProprietaireDe(resource.data.entrepriseId)
          && resource.data.role != 'owner'
          && request.resource.data.entrepriseId == resource.data.entrepriseId
          && request.resource.data.role in ['gerant', 'caissier']
        )
      );

      allow delete: if false;
    }

    // ---------- Entreprises ----------
    match /entreprises/{entId} {
      allow read: if estMembre(entId);
      allow create: if estConnecte() && request.resource.data.ownerId == request.auth.uid;
      // Infos de la boutique (Paramètres) : Propriétaire seulement
      allow update: if estProprietaireDe(entId) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      // ----- Produits -----
      match /produits/{produitId} {
        allow read: if estMembre(entId);
        // Créer / supprimer : Propriétaire + Gérant
        allow create, delete: if estGerantOuPlus(entId);
        // Modifier : Propriétaire + Gérant (tout) ;
        //            Caissier : seulement le stock lors d'une vente
        allow update: if estGerantOuPlus(entId)
          || (estMembre(entId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantite', 'updatedAt']));
      }

      // ----- Ventes, créances, dettes : tout le monde crée et met à jour ; effacer = Gérant+ -----
      match /ventes/{docId} {
        allow read, create, update: if estMembre(entId);
        allow delete: if estGerantOuPlus(entId);
      }
      match /retours/{docId} {
        // Retours de marchandise : tout le monde voit ; Gérant+ crée ; personne ne modifie
        allow read: if estMembre(entId);
        allow create: if estGerantOuPlus(entId);
        allow update, delete: if false;
      }
      match /comptes_clients/{compteId} {
        // Comptes clients (dépôts / avoirs) : on ne supprime jamais
        allow read, create, update: if estMembre(entId);
        allow delete: if false;
        match /mouvements/{mvtId} {
          allow read, create: if estMembre(entId);
          allow update, delete: if false;
        }
      }
      match /creances/{docId} {
        allow read, create, update: if estMembre(entId);
        allow delete: if estGerantOuPlus(entId);
      }
      match /dettes/{docId} {
        allow read, create, update: if estMembre(entId);
        allow delete: if estGerantOuPlus(entId);
      }

      // ----- Écritures comptables : tout le monde crée ; modifier / effacer = Gérant+ -----
      match /ecritures_comptables/{docId} {
        allow read, create: if estMembre(entId);
        allow update, delete: if estGerantOuPlus(entId);
      }

      // ----- Toutes les autres sous-collections (comme avant) -----
      match /{collection}/{reste=**} {
        allow read: if estMembre(entId);
        allow write: if !(collection in ['produits', 'ventes', 'retours', 'comptes_clients', 'creances', 'dettes', 'ecritures_comptables'])
          && (estMembre(entId) || creeParMoi(entId));
      }
    }

    // ---------- Dépenses : Propriétaire + Gérant ----------
    match /depenses/{depenseId} {
      allow read: if estGerantOuPlus(monEntreprise()) && resource.data.entrepriseId == monEntreprise();
      allow create: if estGerantOuPlus(monEntreprise()) && request.resource.data.entrepriseId == monEntreprise();
      allow update: if estGerantOuPlus(monEntreprise()) && resource.data.entrepriseId == monEntreprise()
        && request.resource.data.entrepriseId == resource.data.entrepriseId;
      allow delete: if estGerantOuPlus(monEntreprise()) && resource.data.entrepriseId == monEntreprise();
    }

    // ---------- Ancien chemin (écran Équipe de démonstration) ----------
    match /organizations/{entId}/{document=**} {
      allow read, write: if estMembre(entId);
    }
  }
}